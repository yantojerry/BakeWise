# BakeWise database settings
# Copy this file to .env and fill in the real values for your machine.

# Remote/Aiven MySQL
BAKEWISE_DB_HOST=your-aiven-host
BAKEWISE_DB_PORT=22463
BAKEWISE_DB_USER=avnadmin
BAKEWISE_DB_PASSWORD=your-aiven-password
BAKEWISE_DB_NAME=defaultdb

# Local fallback MySQL
BAKEWISE_LOCAL_HOST=localhost
BAKEWISE_LOCAL_PORT=3307
BAKEWISE_LOCAL_USER=root
BAKEWISE_LOCAL_PASSWORD=
BAKEWISE_LOCAL_DB=bakewise

# Connection pool
BAKEWISE_DB_POOL_SIZE=8
